grid_c2_l1000             | spike_pmap_forward_pass.py           | 5    | --num_residues=1000 --num_recycle=0 --batch_size=2
grid_c4_l100              | spike_pmap_forward_pass.py           | 5    | --num_residues=100  --num_recycle=0 --batch_size=4
grid_c4_l250              | spike_pmap_forward_pass.py           | 5    | --num_residues=250  --num_recycle=0 --batch_size=4
